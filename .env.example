# Free key: https://console.groq.com  (no card needed)
GROQ_API_KEY=your_free_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
# 1 = Assignment 2 controls ON (default). 0 = Assignment 1 baseline (used only for comparison in eval.py)
CONTROLS_ENABLED=1

# --- LangSmith tracing (optional, free plan available): https://smith.langchain.com -> Settings -> API Keys
# set to true (and add your key below) to send traces to LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=aidtm-college-helpdesk
# EU accounts use: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 1 = mask emails/phone numbers before sending (OTP/passwords are ALWAYS redacted). 0 = keep readable.
LANGSMITH_MASK_PII=1
